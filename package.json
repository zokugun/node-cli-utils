{
	"name": "@zokugun/cli-utils",
	"description": "Utils for CLI app",
	"version": "0.3.3",
	"author": {
		"name": "Baptiste Augrain",
		"email": "daiyam@zokugun.org"
	},
	"license": "MIT",
	"homepage": "https://github.com/zokugun/node-cli-utils",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zokugun/node-cli-utils.git"
	},
	"bugs": {
		"url": "https://github.com/zokugun/node-cli-utils/discussions/categories/issue-triage"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/esm/index.mjs",
			"require": "./lib/cjs/index.cjs"
		},
		"./ansi-colors": {
			"import": "./lib/esm/ansi-colors.mjs",
			"require": "./lib/cjs/ansi-colors.cjs"
		},
		"./cli-spinners": {
			"import": "./lib/esm/cli-spinners.mjs",
			"require": "./lib/cjs/cli-spinners.cjs"
		},
		"./commander": {
			"import": "./lib/esm/commander.mjs",
			"require": "./lib/cjs/commander.cjs"
		},
		"./enquirer": {
			"import": "./lib/esm/enquirer.mjs",
			"require": "./lib/cjs/enquirer.cjs"
		},
		"./exec": {
			"import": "./lib/esm/exec.mjs",
			"require": "./lib/cjs/exec.cjs"
		},
		"./logger": {
			"import": "./lib/esm/logger.mjs",
			"require": "./lib/cjs/logger.cjs"
		}
	},
	"main": "lib/cjs/index.cjs",
	"module": "lib/esm/index.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./lib/cjs/index.d.cts"
			],
			"ansi-colors": [
				"./lib/cjs/ansi-colors.d.cts"
			],
			"cli-spinners": [
				"./lib/cjs/cli-spinners.d.cts"
			],
			"commander": [
				"./lib/cjs/commander.d.cts"
			],
			"enquirer": [
				"./lib/cjs/enquirer.d.cts"
			],
			"exec": [
				"./lib/cjs/exec.d.cts"
			],
			"logger": [
				"./lib/cjs/logger.d.cts"
			]
		}
	},
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run build:out",
		"build:out": "tsc-leda generate",
		"build:package": "tsc-leda update-package && npm run lint:package",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf lib .src",
		"compile:src": "tsc -p src",
		"lint": "eslint",
		"lint:all": "npm run lint:package && npm audit && npm run ci:lint",
		"lint:fix": "eslint --fix",
		"lint:package": "fixpack || true",
		"prepack": "npm run build",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"update:artifacts": "artifact update",
		"update:ci": "pinact run -min-age 7 -update",
		"update:deps": "taze --all",
		"watch:build": "tsc-watch -p src --onSuccess 'npm run build'",
		"watch:src": "tsc-watch -p src"
	},
	"dependencies": {
		"@commander-js/extra-typings": "14.0.0",
		"@zokugun/log-update-plus": "0.1.1",
		"@zokugun/picoexec": "0.1.0",
		"ansi-colors": "4.1.3",
		"cli-spinners": "3.4.0",
		"commander": "14.0.3",
		"enquirer": "2.4.1"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@types/node": "20.19.43",
		"@zokugun/eslint-config": "0.2.1",
		"@zokugun/eslint-config-data": "0.2.1",
		"@zokugun/eslint-config-glossary": "0.2.0",
		"@zokugun/eslint-config-js": "0.2.1",
		"@zokugun/eslint-config-md": "0.4.1",
		"@zokugun/eslint-config-nodejs": "0.2.0",
		"@zokugun/eslint-config-style": "0.3.1",
		"@zokugun/eslint-config-ts": "0.3.2",
		"@zokugun/tsc-leda": "0.9.3",
		"eslint": "10.13.0",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"release-it": "20.2.1",
		"rimraf": "6.1.4",
		"taze": "19.17.2",
		"tsc-watch": "7.2.1",
		"typescript": "5.9.3"
	},
	"overrides": {
		"@eslint/config-array": {
			"minimatch": "11.0.1"
		},
		"@inquirer/core": {
			"mute-stream": "3.0.0"
		},
		"@octokit/request": {
			"content-type": "2.1.0"
		},
		"@typescript-eslint/typescript-estree": {
			"minimatch": "11.0.1"
		},
		"eslint": {
			"minimatch": "11.0.1"
		},
		"eslint-plugin-import-x": {
			"minimatch": "11.0.1"
		},
		"get-uri": {
			"basic-ftp": "6.2.3"
		},
		"micromark-extension-math": {
			"katex": "0.18.2"
		},
		"release-it": {
			"undici": "7.30.1"
		}
	},
	"allowScripts": {
		"@zokugun/cli-utils": true,
		"unrs-resolver": true
	},
	"keywords": []
}
